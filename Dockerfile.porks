# Porks custom theme — builds on top of official Chatwoot CE image
# Only overwrites the CSS/Vue files we changed. Build time: ~5min
FROM chatwoot/chatwoot:develop-ce

# Install pnpm (needed for vite asset compilation)
RUN npm install -g pnpm@10.2.0

# Copy our custom theme files over the originals
COPY app/javascript/dashboard/assets/scss/_next-colors.scss /app/app/javascript/dashboard/assets/scss/_next-colors.scss
COPY app/javascript/dashboard/assets/scss/_woot.scss /app/app/javascript/dashboard/assets/scss/_woot.scss
COPY app/javascript/dashboard/components-next/message/bubbles/Base.vue /app/app/javascript/dashboard/components-next/message/bubbles/Base.vue
COPY app/javascript/dashboard/components/widgets/conversation/MessagesView.vue /app/app/javascript/dashboard/components/widgets/conversation/MessagesView.vue
COPY theme/colors.js /app/theme/colors.js

# Install frontend deps and rebuild assets with our changes
WORKDIR /app
RUN pnpm install --frozen-lockfile && \
    SECRET_KEY_BASE=precompile_placeholder \
    RAILS_ENV=production \
    NODE_OPTIONS="--max-old-space-size=4096 --openssl-legacy-provider" \
    bundle exec rails assets:precompile

EXPOSE 3000
